{
  "name": "storytail-adventures",
  "version": "0.0.6",
  "private": true,
  "description": "Story-Tail Adventures CRM platform \u2014 mobile + web + Supabase backend",
  "license": "UNLICENSED",
  "workspaces": [
    "web",
    "contracts"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate:contracts": "npm run generate -w contracts",
    "supabase:start": "set -a; [ -f supabase/.env.local ] && . ./supabase/.env.local; set +a; supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset && ./supabase/scripts/seed-storage-objects.sh",
    "supabase:types": "./supabase/scripts/gen-types.sh",
    "supabase:seed-storage": "./supabase/scripts/seed-storage-objects.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
