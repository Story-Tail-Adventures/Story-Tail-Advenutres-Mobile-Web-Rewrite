# Story-Tail Adventures — web app environment.
#
# Copy to web/.env.local (gitignored) and fill in. For local development the values
# come from `supabase status` after `supabase start`.
#
# This file used to say: NEVER put SUPABASE_SERVICE_ROLE_KEY in it or anywhere under web/.
# That was reversed on purpose on 2026-09-16, and the old rule is left visible here so the
# change reads as a decision rather than an oversight. Live hotel search moved out of
# supabase/functions/hotel-search and runs in this app now; its four tables have RLS on with
# no policies, so the key is required for the feature to work at all. The cost is real and
# unchanged from what the old warning said: the service role bypasses RLS for the ENTIRE
# schema, not just the hotel tables. Keep every server-only value below out of the browser —
# no NEXT_PUBLIC_ prefix, ever. See web/lib/env.ts for the full reasoning.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social sign-in. Leave false until the OAuth clients exist and the matching
# [auth.external.*] blocks are configured in supabase/config.toml.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Public surface (Screen Inventory §2.0). The app subdomain's canonical origin — used for
# metadataBase, canonical URLs, sitemap.xml, robots.txt and the auth callback redirect.
# Required in production; defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where "Message Gyasi without an account" emails go. Phase 1 lead capture is a prefilled
# email (the Lead entity is Phase 2). Defaults to the seed agent's address in development;
# in production, leave it unset and the guest CTAs route to the sign-up gate instead.
NEXT_PUBLIC_INQUIRY_EMAIL=gyasi@example.com

# Marketing-claims gate for web/content/public/proof.ts. Set to "strict" ONLY in the
# production deployment: the build then fails while any claim, testimonial, photo or legal
# page is still marked unverified / unlicensed / draft. Leave unset locally and in previews.
# PUBLIC_CLAIMS_MODE=strict

# Live hotel search (Screen 2.0.4, Hotels mode) — server-only, deliberately NOT NEXT_PUBLIC_.
# The Supabase anon key satisfies the Edge Function's gateway but authenticates nobody: it
# is inlined into the browser bundle. This shared secret is what proves the call came from
# our own server, so it must never gain a NEXT_PUBLIC_ prefix. Set the same value as a
# Supabase secret named HOTEL_SEARCH_CALLER_TOKEN. Unset disables the hotels mode, which
# falls back to the curated catalog rather than erroring.
STA_HOTEL_SEARCH_TOKEN=
# Set to "false" to turn live hotel search off without removing the token.
HOTEL_SEARCH_ENABLED=

# SerpApi key for the Google Hotels engine — server-only, NOT NEXT_PUBLIC_. Was a Supabase
# Edge Function secret; it lives here now because the search that spends it does. This is a
# metered credential billed to us (250 searches/month on the free tier, and an overspent
# month cannot be bought back), so a NEXT_PUBLIC_ prefix here would hand strangers the
# quota. Unset disables the hotels mode rather than erroring.
SERPAPI_API_KEY=

# Server-only pepper for the hotel-search rate limiter — NOT NEXT_PUBLIC_. Caller IPs are
# hashed with it before they become bucket keys, so Postgres never sees a raw address (IP is
# PII per Data-Model, and the table's CHECK constraint refuses anything but a digest).
# Any long random string; `openssl rand -hex 32` is fine. Unset still limits, but an
# unpeppered digest of an IPv4 address is brute-forceable — set it wherever this is deployed.
HOTEL_SEARCH_IP_PEPPER=

# Service-role key — server-only, NOT NEXT_PUBLIC_, and never imported from a client
# component. Required only by in-process hotel search: its four tables (hotel_search_cache,
# hotel_api_request, hotel_search_rate_bucket, hotel_search_config) have RLS on with zero
# policies, because the caller is an anonymous visitor and no policy could describe them.
# This key bypasses RLS for the WHOLE schema, not just those four — there is no narrower key
# to ask Supabase for. `supabase status` prints the local value. Unset leaves hotel search
# unavailable; the rest of the app runs fine without it.
SUPABASE_SERVICE_ROLE_KEY=
