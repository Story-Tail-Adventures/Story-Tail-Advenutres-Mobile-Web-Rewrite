# Story-Tail Adventures — web app environment.
#
# Copy to web/.env.local (gitignored) and fill in. For local development the values
# come from `supabase status` after `supabase start`.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or anywhere under web/. It bypasses
# RLS and belongs only to Edge Functions, which receive it automatically.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social sign-in. Leave false until the OAuth clients exist and the matching
# [auth.external.*] blocks are configured in supabase/config.toml.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Public surface (Screen Inventory §2.0). The app subdomain's canonical origin — used for
# metadataBase, canonical URLs, sitemap.xml, robots.txt and the auth callback redirect.
# Required in production; defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where "Message Gyasi without an account" emails go. Phase 1 lead capture is a prefilled
# email (the Lead entity is Phase 2). Defaults to the seed agent's address in development;
# in production, leave it unset and the guest CTAs route to the sign-up gate instead.
NEXT_PUBLIC_INQUIRY_EMAIL=gyasi@example.com

# Marketing-claims gate for web/content/public/proof.ts. Set to "strict" ONLY in the
# production deployment: the build then fails while any claim, testimonial, photo or legal
# page is still marked unverified / unlicensed / draft. Leave unset locally and in previews.
# PUBLIC_CLAIMS_MODE=strict

# Live CRUISE search (Screen 2.0.4, Cruises mode) — server-only, deliberately NOT NEXT_PUBLIC_.
# It said "hotel search" until hotels moved in-process; `cruise-search` is now the only Edge
# Function reading it, so unsetting it disables CRUISES, not hotels. Getting that backwards
# means unsetting a cruise credential and wondering why hotels is still live.
# The Supabase anon key satisfies the Edge Function's gateway but authenticates nobody: it
# is inlined into the browser bundle. This shared secret is what proves the call came from
# our own server, so it must never gain a NEXT_PUBLIC_ prefix. Set the same value as a
# Supabase secret named HOTEL_SEARCH_CALLER_TOKEN. Unset disables the cruises mode, which
# falls back to the curated catalog rather than erroring.
STA_HOTEL_SEARCH_TOKEN=
# Set to "false" to turn live hotel search off without removing the key below.
HOTEL_SEARCH_ENABLED=

# The SerpApi (Google Hotels) credential — server-only, deliberately NOT NEXT_PUBLIC_, and
# the one secret live hotel search needs. It is the provider key itself rather than a token
# unlocking something of ours, so a NEXT_PUBLIC_ prefix here would inline a metered
# credential into the browser bundle.
#
# IT IS METERED AND THE METER DOES NOT REWIND: 250 searches a month on the free tier, and an
# overspent month cannot be bought back — it resets on its own schedule. Every distinct
# search spends one, so treat a loop over this in development as real money.
#
# Unset disables the hotels mode, which falls back to the curated catalog rather than
# erroring.
SERPAPI_API_KEY=
