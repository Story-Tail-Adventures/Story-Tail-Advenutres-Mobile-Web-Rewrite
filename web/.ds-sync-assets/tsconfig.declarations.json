{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "rootDir": "..",
    "outDir": "./types",
    "baseUrl": ".",
    "paths": {
      "next/link": [
        "./shims/next-link.tsx"
      ],
      "next/image": [
        "./shims/next-image.tsx"
      ],
      "next/navigation": [
        "./shims/next-navigation.ts"
      ],
      "@/lib/auth/actions": [
        "./shims/auth-actions.ts"
      ],
      "@/*": [
        "../*"
      ]
    }
  },
  "files": [
    "../components/ThemeScript.tsx",
    "../components/auth/AuthCard.tsx",
    "../components/auth/FormError.tsx",
    "../components/auth/PasswordStrength.tsx",
    "../components/auth/SocialButtons.tsx",
    "../components/auth/SubmitButton.tsx",
